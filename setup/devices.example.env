# Copy to  devices.env  and edit for THIS machine, then:  source devices.env
# Fill it from:  python tools/list_devices.py

# --- Which python -----------------------------------------------------------
# You do NOT need this if you use the launchers in bin/ (p1, p2, so101 ...) --
# they find the interpreter themselves. It is here for running a script by
# hand, and as an override: bin/so101 sources this file FIRST, so whatever PY
# you set here wins over its own search.
#
# setup/install.sh makes ~/so101venv; the original Jetson was set up by hand
# before install.sh existed and has ~/step0venv. An explicit loop, not
# `ls ... | head -1`, because ls SORTS its output -- with ls the list is
# searched in alphabetical order rather than the order it is written in.
for _c in "$HOME/so101venv/bin/python" "$HOME/step0venv/bin/python"; do
  if [ -x "$_c" ]; then export PY="$_c"; break; fi
done
if [ -z "${PY:-}" ]; then
  echo "devices.env: no virtualenv found. Run: bash setup/install.sh" >&2
else
  echo "devices.env: PY=$PY"
fi

# --- Arms: address by by-id (stable across reboots and USB ports) -----------
export LEADER=/dev/serial/by-id/usb-1a86_USB_Single_Serial_XXXXXXXXXX-if00
export FOLLOWER=/dev/serial/by-id/usb-1a86_USB_Single_Serial_YYYYYYYYYY-if00

# --- Serial registry: THIS is the anti-swap check --------------------------
# Pre-flight compares the serial actually plugged into each port against these.
# Swapping leader and follower otherwise produces NO error -- the arms just
# move and every recorded episode has its fields the wrong way round.
export LEADER_SERIAL=XXXXXXXXXX
export FOLLOWER_SERIAL=YYYYYYYYYY

# --- Cameras: address by by-path (stable per PHYSICAL USB port) -------------
# Never /dev/videoN: it renumbers on replug, and after a disconnect a reconnect
# can land on the OTHER camera -- data records fine, with the wrong label.
export CAM_WRIST=/dev/v4l/by-path/platform-XXXX.usb-usb-0:1.2:1.0-video-index0
export CAM_FRONT=/dev/v4l/by-path/platform-XXXX.usb-usb-0:2.3:1.0-video-index0

# --- Mains frequency, for the cameras' anti-flicker ------------------------
# A property of the ROOM, not of the run, which is why it lives here and not in
# the command. Taiwan is 60. Europe/China are 50. 0 disables it.
# This does NOT touch the exposure -- that is --exposure, a separate setting.
export POWER_LINE_HZ=60

# --- Mounting orientation: 0 / 90 / 180 / 270 ------------------------------
# Applied in the CAPTURE thread, so the video file and the live view get the
# same picture. Correcting it only in the viewer leaves the RECORDING upside
# down, and nobody finds out until a policy is trained on it.
export ROTATE_WRIST=0
export ROTATE_FRONT=0
